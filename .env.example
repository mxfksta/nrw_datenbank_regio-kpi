# ---------------------------------------------------------------------------
# Konfiguration ausschließlich über ENV-Vars (12-Factor). Kopie: cp .env.example .env
# Auf Cloud Run werden diese Variablen am Job gesetzt (siehe README, Deployment).
# ---------------------------------------------------------------------------

# --- GCP / BigQuery ---
GCP_PROJECT=mein-gcp-projekt
BQ_DATASET=kpi_regional
BQ_LOCATION=EU

# Lokal: Pfad zu einem Service-Account-Key. Auf Cloud Run NICHT setzen —
# dort greifen die Application Default Credentials des Job-Service-Accounts.
# GOOGLE_APPLICATION_CREDENTIALS=/pfad/zu/service-account.json

# --- Laufmodus ---
# 1 = keine BigQuery-Schreibzugriffe, Ausgabe als CSV nach ./out (lokales Testen)
DRY_RUN=1
# Zielverzeichnis für DRY_RUN-CSVs
OUT_DIR=./out

# --- Logging ---
LOG_LEVEL=INFO

# --- HTTP-Verhalten ---
HTTP_TIMEOUT_SECONDS=60
# Höfliche Pause zwischen Requests an denselben Host (Sekunden)
HTTP_RATE_LIMIT_SECONDS=1.0
# HTTP_USER_AGENT=regio-kpi-pipeline/0.1 (+https://github.com/mxfksta/nrw_datenbank_regio-kpi)

# --- Landesdatenbank NRW (GENESIS) — bevorzugter, maschinenlesbarer Abrufweg ---
# Kostenlose Registrierung: https://www.landesdatenbank.nrw.de
# Ohne Zugangsdaten fällt der statistik_nrw-Konnektor auf Zensus-XLSX + Kommunalprofil-PDF zurück.
# LDB_NRW_USER=
# LDB_NRW_PASS=

# --- Bundesagentur für Arbeit ---
# Die BA verlinkt Downloads über Suchformulare; die konkreten Download-URLs müssen
# einmalig ermittelt und hier als Template hinterlegt werden ({rs} wird durch den
# 5-stelligen Regionalschlüssel ersetzt). Ohne Konfiguration wird die Quelle übersprungen.
# BA_EINZELHEFT_URL_TEMPLATE=https://statistik.arbeitsagentur.de/.../{rs}/....xlsx
# BA_WZ_CSV_URL_TEMPLATE=https://statistik.arbeitsagentur.de/.../{rs}/....csv
